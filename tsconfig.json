{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false
  },
  "include": ["src", "vite.config.ts"]
}
